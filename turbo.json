{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "BOOTSTRAP_ADMIN_MOBILE",
    "BOOTSTRAP_ADMIN_NAME",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "DATA_ENCRYPTION_KEY",
    "OTP_DEV_MASTER_CODE",
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING"
  ]
}
