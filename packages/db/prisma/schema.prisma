// KBS Solutions — executable data model. Keep DOCS/architecture/03-data-model.md in sync.
// Conventions: UUIDv7 ids, UTC timestamptz, never hard-delete audit-bearing rows.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums (mirror @kbs/shared) ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  TELECALLER
  ADVISOR
  ACCOUNTS
}

enum UserStatus {
  PENDING_ONBOARDING
  ACTIVE
  DEACTIVATED
  BLOCKED
}

enum Platform {
  ANDROID
  WEB
}

enum OtpPurpose {
  LOGIN
  ADVISOR_SIGNUP
}

enum Provenance {
  BANK_MIS
  KBS_OPERATIONAL
  KBS_PAYMENT
}

enum UserLifecycleEventType {
  CREATED
  ACTIVATED
  DEACTIVATED
  BLOCKED
  REACTIVATED
  MOBILE_CHANGED
}

enum ReportingSource {
  MANAGER_CREATED_TELECALLER
  AGENT_CODE
  ADMIN_DEFAULT
  ADMIN_REASSIGNED
}

enum ReportingAssignmentStatus {
  ACTIVE
  PENDING_APPROVAL
  CLOSED
  REJECTED
}

enum AgentCodeStatus {
  ACTIVE
  REVOKED
}

enum ConfigValueType {
  STRING
  INT
  BOOL
  JSON
  USER_ID
  DURATION
}

enum SensitiveField {
  PAN
  MOBILE
  BANK_ACCOUNT
  RECORDING
  CHEQUE
  PROOF
  AADHAAR_RESULT
  MIS_RAW_ROW
  ID_CARD
}

enum NetworkAccessOutcome {
  ALLOWED_OFFICE
  ALLOWED_WFH
  DENIED
}

enum TrainingEnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  EXPIRED_DEACTIVATED
