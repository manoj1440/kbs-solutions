}

enum ModuleResultStatus {
  LOCKED
  IN_PROGRESS
  PASSED
}

enum TrainingModuleStatus {
  DRAFT
  PUBLISHED
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  IMPORTED
  FAILED
  REJECTED
}

enum InteractionStatus {
  UNTOUCHED
  FOLLOW_UP
  INTERESTED
  LINK_SHARED
  DECLINED
  COMPLETED
  UNREACHABLE
}

enum RecordReviewStatus {
  ACCEPTED
  NEEDS_REVIEW
  EXCLUDED
}

enum SuppressionReason {
  CUSTOMER_REQUEST
  COMPLIANCE
  DND_LIST
}

enum CardStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum Channel {
  TELECALLER
  ADVISOR
  BOTH
}

enum ProfileStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum Sourceability {
  SOURCEABLE
  NOT_SOURCEABLE
  REQUIRES_BANK_MAPPING
}

enum CallProviderState {
  REQUESTED
  RINGING
  CONNECTED
  ENDED
  FAILED
  NO_ANSWER
  UNKNOWN
}

enum RecordingStatus {
  NOT_ATTEMPTED
  PENDING
  AVAILABLE
  FAILED
}

enum CallOutcomeKind {
  NO_ANSWER_OR_FAILED
  CONNECTED_INTERESTED
  CONNECTED_LINK_OR_PDF_SHARED
  FOLLOW_UP
  DECLINED
  COMPLETED_NO_FURTHER
