  DELIVERED
  FAILED
}

enum OnboardingStep {
  PERSONAL
  CONSENT
  IDENTITY
  BANK
  CHEQUE
  AGENT_CODE
  REVIEW
  AWAITING_REVIEW
  COMPLETE
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  MISMATCH
  FAILED
  UNAVAILABLE
}

enum ReviewOutcome {
