  },
  "devDependencies": {
    "@kbs/config": "workspace:*",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
