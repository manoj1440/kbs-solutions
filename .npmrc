auto-install-peers=true
strict-peer-dependencies=false
# F-818: Expo/NativeWind Babel presets name plugins they don't declare (e.g. react-native-css-interop →
# @babel/plugin-transform-react-jsx); EAS's fresh install can't see pnpm's hidden hoist, so expose @babel/* at the root.
# Listing any pattern replaces pnpm's defaults, so the default eslint/prettier ones are repeated.
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
