{
  "name": "kbs-solutions",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --filter=api --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @kbs/db generate",
    "db:migrate": "pnpm --filter @kbs/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @kbs/db migrate:dev",
    "db:seed": "pnpm --filter @kbs/db seed",
    "db:studio": "pnpm --filter @kbs/db studio",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:reset": "docker compose -f docker/docker-compose.yml down -v",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@kbs/config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
