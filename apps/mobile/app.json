{
  "expo": {
    "name": "KBS Solutions",
    "slug": "kbs",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kbs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EEE8"
    },
    "android": {
      "package": "com.kbs.dsa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#F05A28"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d52957fe-d8b8-497b-ac7c-52ca691f43be"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "manojskidoss-team",
    "updates": {
      "url": "https://u.expo.dev/d52957fe-d8b8-497b-ac7c-52ca691f43be"
    }
  }
}
