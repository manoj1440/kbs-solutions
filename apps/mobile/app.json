{
  "expo": {
    "name": "KBS Solutions",
    "slug": "kbs-solutions",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kbs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.kbs.dsa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#16329E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {},
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
