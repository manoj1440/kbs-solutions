# ── runtime ──
NODE_ENV=development
API_PORT=4000
WORKER_MODE=0            # 1 = run BullMQ processors only (no HTTP)
JOBS_INLINE=1            # dev convenience: run processors inside the API process
TRUST_PROXY_HOPS=0       # number of reverse proxies in front of the API (for client IP resolution)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
TZ=UTC

# ── data stores ──
DATABASE_URL=postgresql://kbs:kbs@localhost:5432/kbs
REDIS_URL=redis://localhost:6379

# ── secrets (generate with: openssl rand -base64 32) ──
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=   # 32 bytes base64 (AES-256-GCM for PAN / bank accounts)
OTP_PEPPER=change-me-pepper

# ── providers (ADR-009) ──
OTP_PROVIDER=console          # console | (real vendors added later)
OTP_DEV_MASTER_CODE=000000    # accepted in non-production when set; leave empty in prod
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=handoff
KYC_PROVIDER=mock
PAN_PROVIDER=mock
PUSH_PROVIDER=mock
SCAN_PROVIDER=noop
STORAGE_PROVIDER=s3           # s3 | memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=kbs-private
S3_ACCESS_KEY=kbsminio
S3_SECRET_KEY=kbsminio123
S3_FORCE_PATH_STYLE=1
API_PUBLIC_URL=http://localhost:4000
