# ── runtime ──
NODE_ENV=development
API_PORT=4000
WORKER_MODE=0            # 1 = run BullMQ processors only (no HTTP)
JOBS_INLINE=1            # dev convenience: run processors inside the API process
TRUST_PROXY_HOPS=0       # number of reverse proxies in front of the API (for client IP resolution)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
TZ=UTC

# ── data stores ──
DATABASE_URL=postgresql://kbs:kbs@localhost:5432/kbs
REDIS_URL=redis://localhost:6379

# ── secrets (generate with: openssl rand -base64 32) ──
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=   # 32 bytes base64 (AES-256-GCM for PAN / bank accounts)
OTP_PEPPER=change-me-pepper

# ── providers (ADR-009) ──
OTP_PROVIDER=console          # console (code printed in the API log, dev only) | msg91 (real SMS — DOCS/runbooks/07-sms-otp-provider.md)
# MSG91_AUTH_KEY=             # required when OTP_PROVIDER=msg91 (boot fails without the three keys below)
# MSG91_TEMPLATE_ID=          # MSG91's id of the approved SMS template (holds the DLT template id)
# MSG91_SENDER_ID=            # DLT-registered header, 6 letters
# MSG91_OTP_VARIABLE=VAR1     # optional: variable name in the template (##VAR1##), case-sensitive
# MSG91_HOST=control.msg91.com  # optional host override (host only, no https://)
OTP_DEV_MASTER_CODE=000000    # accepted in non-production when set; leave empty in prod
TELEPHONY_PROVIDER=mock        # mock | exotel (then set EXOTEL_HOST, EXOTEL_ACCOUNT_SID, EXOTEL_API_KEY, EXOTEL_API_TOKEN, EXOTEL_CALLER_ID, EXOTEL_WEBHOOK_TOKEN)
WHATSAPP_PROVIDER=handoff
KYC_PROVIDER=mock             # mock (payload MOCK_OK) | cashfree (Aadhaar via DigiLocker — DOCS/runbooks/09-kyc-pan-provider.md; needs an https API_PUBLIC_URL)
PAN_PROVIDER=mock             # mock | cashfree (Cashfree Secure ID PAN verification — same runbook)
# CASHFREE_VERIFICATION_CLIENT_ID=      # required when either provider above is cashfree (boot fails without these three). Secure ID keys, not Payment Gateway keys
# CASHFREE_VERIFICATION_CLIENT_SECRET=
# CASHFREE_VERIFICATION_ENV=sandbox     # sandbox | production (must be production when NODE_ENV=production)
# CASHFREE_VERIFICATION_PUBLIC_KEY=     # optional PEM (one line, \n for line breaks): only when Cashfree 2FA method is "Public Key"; leave empty for "IP Whitelist"
# CASHFREE_VERIFICATION_API_VERSION=2024-08-01  # optional x-api-version for the PAN call
THROTTLE_LIMIT_PER_MIN=300      # per-IP requests per minute; raise only for perf runs (F-905)
PUSH_PROVIDER=mock          # mock | expo (Expo push service; provider choice is OPEN per REQ-19 §19.2)
# EXPO_ACCESS_TOKEN=          # optional Expo access token when PUSH_PROVIDER=expo
SCAN_PROVIDER=noop            # noop | clamav (F-902; noop marks files SKIPPED — never CLEAN)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
STORAGE_PROVIDER=s3           # s3 | memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=kbs-private
S3_ACCESS_KEY=kbsminio
S3_SECRET_KEY=kbsminio123
S3_FORCE_PATH_STYLE=1
API_PUBLIC_URL=http://localhost:4000
