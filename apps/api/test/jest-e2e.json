{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1" },
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json", "isolatedModules": true }] },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 60000
}
